config main 'main'
	# ===== 基本设置 =====
	option enabled '1'
	option redirect '1'
	option local_dns 'https://223.5.5.5/dns-query'
	option remote_dns 'https://8.8.8.8/dns-query'
	option stream_dns ''
	option bootstrap '119.29.29.29:53'
	option fallback 'remote'
	option apple_optimization '0'
	option dns_leak '0'
	option cache '1'
	option cache_size '8000'
	option lazy_cache_ttl '86400'
	option reject_type65 '1'
	option ipv6 '0'

	# ===== 规则清单（每行一个域名，支持 domain/full/keyword/geosite 前缀）=====
	option whitelist ''
	option blacklist ''
	option greylist ''
	option stream_media ''
	option ddns ''
	option hosts ''
	option redirect_list ''
	option ptr_blacklist ''
